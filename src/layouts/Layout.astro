---
// src/layouts/Layout.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Christian Kusumadjaja - Portfolio</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    
    <style is:global>
	:root {
        --bg-color: #F7F5F0; /* Creamy off-white, kanvas yang bersih */
        --text-color: #2A2421; /* Espresso dark, coklat sangat pekat mendekati hitam */
        --accent-color: #694A38; /* Walnut brown, coklat kayu yang elegan tanpa unsur oranye */
        --border-color: #D6D0C4; /* Soft greige untuk garis pembatas yang lembut */
        --font-heading: 'Playfair Display', serif;
        --font-body: 'Manrope', sans-serif;
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth; /* Efek meluncur saat menu diklik */
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-color);
        font-family: var(--font-body);
        line-height: 1.6;
        margin: 0;
        padding: 0;
      }

      h1, h2, h3, .heading-font {
        font-family: var(--font-heading);
        font-weight: 600;
        margin-top: 0;
        margin-bottom: 0.5rem;
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      @media print {
        body { background-color: #ffffff; }
        .container { max-width: 100%; padding: 0 1rem; }
      }
    </style>
  </head>
  <body>
    <slot /> 
  </body>
</html>