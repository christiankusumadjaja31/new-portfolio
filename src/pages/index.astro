---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro'; // Pastikan komponen ini ada
---

<Layout>
  <Navbar />
  <Hero />
  <About />

  <section id="journey" class="container">
    <div class="section-header">
      <h2 class="heading-font section-title">My Journey</h2>
    </div>

    <!-- BAB 1 -->
    <div class="story-chapter">
      <div class="story-media">
        <!-- Bingkai tebal diterapkan -->
        <div class="custom-frame landscape-frame">
          <img src="/the-engineering-path.png" alt="Kegiatan Kampus" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>
      <div class="story-text">
        <h3 class="heading-font">The Engineering Path</h3>
        <p>
          Starting Computer Science with zero programming background was intimidating, but I turned that insecurity into a relentless drive to learn. From my first lines of C, I aggressively expanded my stack—mastering frontend frameworks (Mantine/TypeScript), Big Data architectures, Python data processing, and Pentaho pipelines. 
        </p>
        <p>
          Graduating from basic algorithms to building predictive models, my academic journey (currently at a 3.92 GPA) is proof of my commitment to continuous growth. Now, my focus is locked on Database Technology: learning how scalable, production-grade systems can solve complex business puzzles.
        </p>
      </div>
    </div>

    <!-- BAB 2 -->
    <div class="story-chapter reverse-layout">
      <div class="story-text">
        <h3 class="heading-font">Growing Through Community</h3>
        <p>
          Beyond the screen, I serve as the Territorial Division Lead at my Parish Youth Ministry (OMK Kedoya), managing community development across diverse neighborhoods. For an introvert, continuous diplomacy can be exhausting. 
        </p>
        <p>
          Yet, a realization during a retreat—that <em>"faith is meant to be shared"</em>—shifted my perspective. I learned to focus on the mission over my discomfort. This role taught me a profound lesson not found in any syllabus: how to lead without formal authority, purely through trust, active listening, and service.
        </p>
      </div>
      <div class="story-media">
        <!-- Bingkai tebal diterapkan -->
        <div class="custom-frame landscape-frame">
          <img src="/community-pic.png" alt="Kegiatan Kampus" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>
    </div>

    <!-- BAB 3 -->
    <div class="story-bridge">
      <h3 class="heading-font">Where Both Worlds Meet</h3>
      <p>
        Ultimately, my technical and social worlds collided. I saw my parish struggling to manage data across 10 regions and 45 neighborhoods using scattered spreadsheets. Applying the systems-thinking I learned in CS, I engineered a digital directory and attendance system. 
      </p>
      <p class="highlight-text">
        I realized then: technical skill without social empathy creates systems nobody uses, while leadership without the right tools doesn't scale. The intersection of both is exactly where I build.
      </p>
    </div>
  </section>

  <section id="projects" class="container">
    
    <ProjectCard 
      number="1"
      title="Church Directory Web Platform"
      context="REAL-WORLD SOLUTION / FULL-STACK"
      repoUrl="https://github.com/your-username/church-directory"
      summary="A practical web-based directory designed and built to address real-world community management needs, streamlining access to essential organizational information."
      impacts={[
        "Translated real-world operational bottlenecks into a structured digital solution.",
        "Delivered an intuitive user interface tailored for non-technical end-users."
      ]}
      learnings={[
        "Learned how to align software architecture directly with community needs.",
        "Refined skills in end-to-end web deployment and user-centric design."
      ]}
    >
      <!-- HANYA MENGGUNAKAN KOTAK PUTUS-PUTUS SEDERHANA DI SINI -->
      <div class="project-placeholder">
        <span class="placeholder-text">Insert Project Image Here<br/>Size: 1200 x 675 px (16:9)</span>
      </div>
    </ProjectCard>

    <ProjectCard 
      number="2"
      title="PoestaKas Frontend Interface"
      context="TEAM COLLABORATION / UI ENGINEERING"
      repoUrl="https://github.com/your-username/poestakas"
      summary="A collaborative frontend web application developed with React and Mantine UI, focusing on seamless business profile management and financial dashboard routing."
      impacts={[
        "Architected a clean navigation flow utilizing React Router for a seamless single-page application experience.",
        "Ensured visual consistency and scalable component structures within a team environment."
      ]}
      learnings={[
        "Mastered state management and component routing in modern frontend frameworks.",
        "Discovered how applying strict logical structure drastically improves UI maintainability."
      ]}
    >
      <div class="project-placeholder">
        <span class="placeholder-text">Insert Project Image Here<br/>Size: 1200 x 675 px (16:9)</span>
      </div>
    </ProjectCard>

    <ProjectCard 
      number="3"
      title="Enterprise Data Integration Pipeline"
      context="BACKEND LOGIC / DATA ENGINEERING"
      repoUrl="https://github.com/your-username/pentaho-pipeline"
      summary="An ETL (Extract, Transform, Load) pipeline engineered using Pentaho to clean, transform, and integrate raw datasets into a structured database architecture."
      impacts={[
        "Successfully mapped and integrated disparate raw data sources into a unified star schema model.",
        "Automated data transformation processes, reducing manual cleaning efforts."
      ]}
      learnings={[
        "Deepened understanding of database schema design and backend data integrity.",
        "Learned to troubleshoot data bottlenecks and ensure structural reliability."
      ]}
    >
      <div class="project-placeholder">
        <span class="placeholder-text">Insert Project Image Here<br/>Size: 1200 x 675 px (16:9)</span>
      </div>
    </ProjectCard>

    <ProjectCard 
      number="4"
      title="Maven Roasters Business Dashboard"
      context="BUSINESS INTELLIGENCE / VISUALIZATION"
      repoUrl="https://github.com/your-username/tableau-maven"
      summary="An interactive Tableau dashboard designed to translate complex sales metrics and product mix data into an actionable visual narrative for stakeholders."
      impacts={[
        "Formulated a clear data storytelling structure around revenue growth trends and peak traffic hours.",
        "Created an intuitive container layout that non-technical users can easily navigate."
      ]}
      learnings={[
        "Learned to bridge the gap between raw backend data and frontend business strategy.",
        "Mastered the art of presenting technical metrics as digestible visual insights."
      ]}
    >
      <div class="project-placeholder">
        <span class="placeholder-text">Insert Project Image Here<br/>Size: 1200 x 675 px (16:9)</span>
      </div>
    </ProjectCard>

    <ProjectCard 
      number="5"
      title="Analytical Prediction Model Evaluation"
      context="RESEARCH / MACHINE LEARNING"
      repoUrl="https://github.com/your-username/xai-model-eval"
      summary="An experimental research methodology evaluating the reasoning faithfulness and prediction sensitivity of an AI model on informal text datasets."
      impacts={[
        "Designed a rigorous testing environment using manually filtered datasets and counterfactual interventions.",
        "Identified critical flaws and bias within the model's predictive capabilities."
      ]}
      learnings={[
        "Gained invaluable insights into data leakage, overfitting, and the importance of critical model evaluation.",
        "Learned that identifying a system's vulnerability is just as crucial as building it."
      ]}
    >
      <div class="project-placeholder">
        <span class="placeholder-text">Insert Project Image Here<br/>Size: 1200 x 675 px (16:9)</span>
      </div>
    </ProjectCard>

  </section>

  <Footer />
</Layout>

<style>
  #journey { margin-bottom: 6rem; }

  .section-header { margin-bottom: 3rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; text-align: center; }
  .section-title { font-size: 2.8rem; color: var(--text-color); margin: 0; }

  .story-chapter { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; margin-bottom: 5rem; }
  .story-text h3 { font-size: 2rem; color: var(--accent-color); margin-bottom: 1.5rem; }
  .story-text p { font-size: 1.1rem; line-height: 1.8; margin-bottom: 1.2rem; color: var(--text-color); }

  /* DROP CAP EFFECT */
  .story-text p:first-of-type::first-letter {
    font-family: var(--font-heading);
    font-size: 4rem; 
    font-weight: 600;
    color: var(--accent-color);
    float: left; 
    line-height: 1;
    padding-right: 0.5rem;
    padding-top: 0.2rem;
  }

  .story-bridge {
    max-width: 800px;
    margin: 6rem auto 4rem auto;
    text-align: center;
    padding: 3rem;
    background-color: rgba(105, 74, 56, 0.03); 
    border: 1px solid var(--border-color);
    border-radius: 4px;
  }

  .story-bridge h3 { font-size: 2.2rem; color: var(--accent-color); margin-bottom: 1.5rem; }
  .story-bridge p { font-size: 1.15rem; line-height: 1.8; color: var(--text-color); margin-bottom: 1.5rem; }
  .story-bridge .highlight-text { font-family: var(--font-heading); font-size: 1.4rem; font-style: italic; color: var(--accent-color); margin-top: 2rem; }

  /* BINGKAI TEBAL COKELAT & PUTIH (KHUSUS JOURNEY) */
  .custom-frame {
    background-color: #FFFFFF; 
    border: 12px solid var(--accent-color); 
    padding: 1rem; 
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .landscape-frame { width: 100%; aspect-ratio: 4 / 3; }

  /* GAYA SEDERHANA KHUSUS PROJECT (Tanpa Bingkai Tebal) */
  .project-placeholder { 
    width: 100%; 
    aspect-ratio: 16 / 9; 
    max-height: 400px; 
    border: 1px dashed var(--accent-color); 
    background-color: rgba(105, 74, 56, 0.05); 
    border-radius: 4px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .placeholder-text { 
    font-family: var(--font-body); 
    font-size: 1rem; 
    color: var(--accent-color); 
    letter-spacing: 0.05em; 
    opacity: 0.7; 
  }

  @media print {
    #journey { margin-bottom: 3rem; }
    .story-chapter { gap: 2rem; margin-bottom: 3rem; page-break-inside: avoid; }
    .story-text p { font-size: 1rem; }
    .story-bridge { margin: 3rem auto; padding: 1.5rem; page-break-inside: avoid; }
    
    .custom-frame { 
      border-width: 6px; 
      padding: 0.75rem;
      page-break-inside: avoid; 
    }
    .project-placeholder {
      background-color: #FDFDFB; 
      border-color: #cccccc;
      page-break-inside: avoid;
    }
  }
</style>