---
// src/components/Footer.astro
---
<footer id="contact" class="web-footer container">
  <div class="footer-content">
    <h2 class="heading-font">Let's Connect</h2>
    <p>I'm always open to discussing interdisciplinary tech ideas.</p>
    
    <div class="social-links">
      <!-- Icon Email -->
      <a href="mailto:christian@email.com" aria-label="Email">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>
      
      <!-- Icon LinkedIn -->
      <a href="https://linkedin.com/in/christian" target="_blank" aria-label="LinkedIn">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
      
      <!-- Icon GitHub -->
      <a href="https://github.com/christian" target="_blank" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .web-footer {
    padding: 6rem 2rem;
    margin-top: 2rem;
  }
  
  .footer-content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .footer-content h2 { font-size: 2.5rem; color: var(--accent-color); }
  .footer-content p { color: #4A3E39; }

  .social-links {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
    gap: 2rem;
  }

  .social-links a {
    color: var(--text-color);
    transition: color 0.3s ease, transform 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .social-links a:hover {
    color: var(--accent-color);
    transform: translateY(-3px); /* Efek melayang saat di-hover */
  }

  @media print { .web-footer { display: none !important; } }
</style>