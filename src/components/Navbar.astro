---
// src/components/Navbar.astro
---
<nav class="navbar">
  <div class="nav-container">
    <div class="nav-group left">
      <a href="#hero">Home</a>
      <a href="#about">About</a>
    </div>
    
    <div class="logo heading-font">
      <span class="logo-italic">Christian</span> Kusumadjaja
    </div>
    
    <div class="nav-group right">
      <a href="#projects">Projects</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background-color: rgba(253, 251, 247, 0.95);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .nav-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 900px; /* Membatasi lebar agar keseluruhan menu lebih ke tengah */
    margin: 0 auto;
    padding: 1.2rem 2rem;
  }
  
  .logo { 
    font-size: 1.4rem; 
    text-align: center;
    letter-spacing: 0.02em;
  }

  /* Membuat nama depan italic dan berwarna terracotta agar unik */
  .logo-italic {
    font-style: italic;
    color: darkgoldenrod;
    font-weight: 600;
  }
  
  .nav-group {
    display: flex;
    gap: 2.5rem; /* Jarak antar tombol menu */
  }
  
  /* Mendorong menu agar merapat ke arah tengah (ke logo) */
  .nav-group.left { justify-content: flex-end; padding-right: 3rem; }
  .nav-group.right { justify-content: flex-start; padding-left: 3rem; }

  .nav-group a {
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .nav-group a:hover {
    color: var(--accent-color);
  }

  @media print { .navbar { display: none !important; } }
</style>