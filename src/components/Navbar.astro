---
// src/components/Navbar.astro
---
<nav class="navbar">
  <div class="nav-container container">
    
    <div class="nav-links left">
      <a href="#about" class="nav-link">Interest & Motivation</a>
      <a href="#journey" class="nav-link">Journey</a>
    </div>
    
    <div class="nav-brand">
      <a href="#" class="brand-name">Christian Kusumadjaja</a>
    </div>
    
    <div class="nav-links right">
      <a href="#projects" class="nav-link">Projects</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>

  </div>
</nav>

<style>
  .navbar {
    width: 100%;
    border-bottom: 1px solid var(--border-color);
    background-color: rgba(247, 245, 240, 0.9); 
    backdrop-filter: blur(4px); 
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .nav-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 80px;
  }

  .nav-links { display: flex; gap: 3rem; }
  .nav-links.left { justify-content: flex-end; padding-right: 3rem; }
  .nav-links.right { justify-content: flex-start; padding-left: 3rem; }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.7rem; 
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s ease;
    padding: 0;
    margin: 0;
  }

  .brand-name:hover { opacity: 0.7; }

  .nav-link {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em; 
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .nav-link:hover { color: var(--accent-color); }

  @media print { .navbar { display: none; } }
</style>