---
// src/components/Navbar.astro
---
<nav class="navbar">
  <div class="nav-container container">
    
    <!-- KIRI: Hanya muncul di Desktop -->
    <div class="nav-links left desktop-only">
      <a href="#about" class="nav-link">Interest & Motivation</a>
      <a href="#journey" class="nav-link">Journey</a>
    </div>
    
    <!-- TENGAH: Nama -->
    <div class="nav-brand">
      <a href="#" class="brand-name">Christian Kusumadjaja</a>
    </div>
    
    <!-- KANAN: Hanya muncul di Desktop -->
    <div class="nav-links right desktop-only">
      <a href="#projects" class="nav-link">Projects</a>
      <a href="#contact" class="nav-link">Contact</a>
    </div>

    <!-- TOMBOL HAMBURGER: Hanya muncul di Mobile -->
    <button class="hamburger mobile-only" aria-label="Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

  </div>

  <!-- MENU DROPDOWN: Hanya muncul di Mobile -->
  <div class="mobile-menu mobile-only">
    <a href="#about" class="mobile-link">Interest & Motivation</a>
    <a href="#journey" class="mobile-link">Journey</a>
    <a href="#projects" class="mobile-link">Projects</a>
    <a href="#contact" class="mobile-link">Contact</a>
  </div>
</nav>

<style>
  /* --- GAYA GLOBAL NAVBAR --- */
  .navbar {
    width: 100%;
    border-bottom: 1px solid var(--border-color);
    background-color: rgba(247, 245, 240, 0.9); 
    backdrop-filter: blur(4px); 
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .nav-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 80px;
  }

  .nav-links { display: flex; gap: 3rem; }
  .nav-links.left { justify-content: flex-end; padding-right: 3rem; }
  .nav-links.right { justify-content: flex-start; padding-left: 3rem; }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.7rem; 
    color: var(--text-color);
    text-decoration: none;
    font-weight: 600;
    transition: opacity 0.3s ease;
    padding: 0;
    margin: 0;
  }

  .brand-name:hover { opacity: 0.7; }

  .nav-link {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em; 
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .nav-link:hover { color: var(--accent-color); }

  /* --- PENGUNCI VISIBILITAS (Mencegah Kebocoran) --- */
  /* Secara default (di layar Laptop), Sembunyikan elemen mobile 100% mutlak */
  .mobile-only {
    display: none !important;
  }

  @media print { .navbar { display: none !important; } }

  /* --- GAYA KHUSUS MOBILE (Layar HP di bawah 768px) --- */
  @media (max-width: 768px) {
    
    /* Balikkan Visibilitas! Sembunyikan desktop, Munculkan mobile */
    .desktop-only { display: none !important; }
    .mobile-only { display: flex !important; }

    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 1.25rem;
      height: 70px;
    }

    .brand-name { font-size: 1.4rem; }

    /* TOMBOL HAMBURGER */
    .hamburger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 18px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 1001;
    }
    
    .hamburger .bar {
      width: 100%;
      height: 2px;
      background-color: var(--text-color);
      border-radius: 2px;
      transition: all 0.3s ease;
    }
    
    /* Animasi Hamburger menjadi 'X' */
    .hamburger.active .bar:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .hamburger.active .bar:nth-child(2) { opacity: 0; }
    .hamburger.active .bar:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    /* MENU DROPDOWN MOBILE */
    .mobile-menu {
      flex-direction: column;
      position: absolute;
      top: 70px; /* Pas di bawah navbar */
      left: 0;
      width: 100%;
      background-color: var(--bg-color);
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      
      /* Animasi sembunyi/muncul */
      max-height: 0; 
      padding: 0 1.25rem;
      overflow: hidden;
      transition: max-height 0.4s ease, padding 0.4s ease;
    }

    /* Kelas yang ditambahkan JS saat dibuka */
    .mobile-menu.open {
      max-height: 400px; 
      padding: 1.5rem 1.25rem;
    }

    .mobile-link {
      font-family: var(--font-body);
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-decoration: none;
      color: var(--text-color);
      font-weight: 600;
      padding: 1rem 0;
      border-bottom: 1px dotted var(--border-color);
      text-align: center;
    }

    .mobile-link:last-child { border-bottom: none; }
  }
</style>

<script>
  // FUNGSI JAVASCRIPT UNTUK KLIK MENU MOBILE
  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.querySelector('.hamburger');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (hamburger && mobileMenu) {
      // Buka/tutup menu saat logo hamburger diklik
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
      });

      // Tutup menu secara otomatis setelah link dipilih
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });
    }
  });
</script>