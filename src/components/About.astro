---
// src/components/About.astro
---
<section id="about" class="container">
  <div class="about-grid">
    
    <div class="about-title">
      <h2 class="heading-font">Interest &<br/>Motivation.</h2>
    </div>

    <div class="about-content">
      <div class="about-statement">
        <h3 class="heading-font">"I believe that brilliant architecture is invisible; you only notice the impact it creates."</h3>
      </div>
      
      <div class="about-text">
        <p>
          As a Computer Science student specializing in Database Technology, I am captivated by what happens behind the scenes. My passion lies in turning chaotic, fragmented data into structured, scalable solutions through robust data engineering, ETL pipelines, and backend architecture.
        </p>
        <p>
          I thrive on solving structural puzzles to build the quiet engines that drive informed decision-making. Ultimately, I engineer with empathy—bridging complex technical architecture with human-centric design to ensure the systems I build truly empower the people who rely on them.
        </p>
      </div>

      <!-- TOMBOL DOWNLOAD DIKEMBALIKAN -->
      <div class="action-buttons">
        <a href="/CV_Christian_Kusumadjaja.pdf" target="_blank" class="btn btn-primary">Download CV</a>
        <a href="javascript:window.print()" class="btn btn-outline">Save as PDF</a>
      </div>

    </div>

  </div>
</section>

<style>
  #about {
    padding-top: 4rem;
    padding-bottom: 6rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--border-color);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 2fr; 
    gap: 4rem;
    align-items: flex-start;
  }

  .about-title h2 {
    font-size: 2.5rem;
    line-height: 1.2;
    color: var(--text-color);
    margin: 0;
    position: sticky;
    top: 100px; 
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-statement h3 {
    font-size: 2.2rem;
    line-height: 1.3;
    color: var(--accent-color);
    margin: 0;
    font-style: italic;
    font-weight: 500;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-text p {
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-color);
    margin: 0;
  }

  /* --- GAYA TOMBOL DOWNLOAD --- */
  .action-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-primary {
    background-color: var(--accent-color);
    color: #FFFFFF;
    border: 2px solid var(--accent-color);
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--accent-color);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--accent-color);
    border: 2px solid var(--accent-color);
  }

  .btn-outline:hover {
    background-color: var(--accent-color);
    color: #FFFFFF;
  }

  /* Sembunyikan tombol saat dicetak menjadi PDF agar halamannya bersih */
  @media print {
    #about { padding-top: 2rem; padding-bottom: 3rem; margin-bottom: 2rem; page-break-inside: avoid; }
    .about-grid { gap: 2rem; }
    .about-title h2 { font-size: 2rem; position: static; }
    .about-statement h3 { font-size: 1.8rem; }
    .about-text p { font-size: 1.05rem; }
    .action-buttons { display: none !important; } 
  }

  /* --- MOBILE RESPONSIVE --- */
  @media (max-width: 768px) {
    #about { padding-top: 2rem; padding-bottom: 3rem; margin-bottom: 3rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-title h2 { position: static; font-size: 2.2rem; }
    .about-statement h3 { font-size: 1.8rem; }
    
    /* Tombol membentang penuh di layar HP */
    .action-buttons { flex-direction: column; gap: 1rem; }
    .btn { width: 100%; }
  }
</style>