---
// src/components/ProjectCard.astro

// Kita tambahkan Interface Props ini untuk TypeScript
interface Props {
  number: string;
  title: string;
  context: string;
  summary: string;
  impacts: string[];
  learnings: string[];
}

const { number, title, context, summary, impacts, learnings } = Astro.props;
---

<div class="project-card">
  <div class="project-header">
    <div class="project-title-group">
      <span class="project-number">{number}.</span>
      <h2 class="project-title heading-font">{title}</h2>
    </div>
    <span class="project-context">{context}</span>
  </div>

  <p class="project-summary">{summary}</p>

  <div class="project-details">
    <div class="detail-column">
      <h3 class="detail-heading heading-font">Impact</h3>
      <ul>
        {impacts.map((impact) => (
          <li>{impact}</li>
        ))}
      </ul>
    </div>
    <div class="detail-column">
      <h3 class="detail-heading heading-font">Learnings</h3>
      <ul>
        {learnings.map((learning) => (
          <li>{learning}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Tempat di mana galeri gambar dari index.astro akan muncul -->
  <div class="project-media">
    <slot />
  </div>
</div>

<style>
  .project-card {
    /* KUNCI UTAMA: Menghapus background putih agar menyatu dengan kanvas */
    background-color: transparent; 
    border: none;
    box-shadow: none;
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color); /* Garis pemisah antar proyek */
  }

  .project-card:last-child {
    border-bottom: none;
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .project-title-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .project-number {
    font-size: 1.8rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--accent-color);
  }

  .project-title {
    font-size: 2rem;
    color: var(--text-color);
  }

  .project-context {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent-color);
    text-transform: uppercase;
  }

  .project-summary {
    font-size: 1.15rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    font-style: italic;
    color: var(--text-color);
  }

  .project-details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .detail-heading {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    color: var(--text-color);
  }

  .detail-column ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .detail-column li {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .project-media {
    width: 100%;
  }

  /* Keajaiban Print ke PDF */
  @media print {
    .project-card {
      padding: 1.5rem 0;
      page-break-inside: avoid;
    }
    
    .project-title {
      font-size: 1.6rem;
    }
    
    .project-summary {
      font-size: 1rem;
    }
  }
</style>