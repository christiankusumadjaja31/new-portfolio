---
// src/components/ProjectCard.astro
interface Props {
  number: string;
  title: string;
  context: string;
  summary: string;
  impacts: string[];
  learnings: string[];
  repoUrl?: string; 
}

const { number, title, context, summary, impacts, learnings, repoUrl } = Astro.props;
---

<div class="project-card">
  <div class="project-header">
    <div class="project-title-group">
      <span class="project-number">{number}.</span>
      <h2 class="project-title heading-font">{title}</h2>
    </div>
    <span class="project-context">{context}</span>
  </div>

  <div class="project-media">
    <slot />
  </div>

  <p class="project-summary">{summary}</p>

  <div class="project-details">
    <div class="detail-column">
      <h3 class="detail-heading heading-font">Impact</h3>
      <ul>
        {impacts.map((impact) => <li>{impact}</li>)}
      </ul>
    </div>
    <div class="detail-column">
      <h3 class="detail-heading heading-font">Learnings</h3>
      <ul>
        {learnings.map((learning) => <li>{learning}</li>)}
      </ul>
    </div>
  </div>

  {repoUrl && (
    <div class="project-footer">
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="repo-link">
        Review Source Code <span class="arrow">↗</span>
      </a>
    </div>
  )}
</div>

<style>
  .project-card {
    background-color: transparent; 
    border: none;
    box-shadow: none;
    padding: 3rem 0;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color); 
  }

  .project-card:last-child { border-bottom: none; }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline; 
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem; 
  }

  .project-title-group { display: flex; align-items: baseline; gap: 0.75rem; }
  .project-number { font-size: 1.8rem; font-family: var(--font-heading); font-weight: 600; color: var(--accent-color); }
  .project-title { font-size: 2rem; color: var(--text-color); }
  .project-context { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.05em; color: var(--text-color); text-transform: uppercase; }

  .project-media { width: 100%; margin-bottom: 2rem; }
  .project-summary { font-size: 1.15rem; line-height: 1.6; margin-bottom: 2rem; font-style: italic; color: var(--text-color); }

  .project-details {
    display: grid;
    grid-template-columns: 1fr 1fr; 
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .detail-heading { font-size: 1.3rem; margin-bottom: 1rem; color: var(--text-color); border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem; }
  .detail-column ul { margin: 0; padding-left: 1.2rem; }
  .detail-column li { margin-bottom: 0.75rem; font-size: 0.95rem; }

  .project-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-color);
    display: flex;
    justify-content: flex-end; 
  }

  .repo-link {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--accent-color);
    text-decoration: none;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .repo-link:hover { opacity: 0.6; }
  .repo-link .arrow { font-style: normal; font-family: var(--font-body); font-size: 1rem; }

  @media print {
    .project-card { padding: 1rem 0; page-break-inside: avoid; }
    .project-footer { display: none; } 
  }

  /* --- MOBILE RESPONSIVE --- */
  @media (max-width: 768px) {
    .project-card { padding: 2rem 0; }
    .project-title { font-size: 1.6rem; }
    .project-number { font-size: 1.4rem; }
    .project-details { grid-template-columns: 1fr; gap: 1.5rem; } /* Menumpuk Impact & Learnings */
    .project-footer { justify-content: flex-start; }
  }
</style>