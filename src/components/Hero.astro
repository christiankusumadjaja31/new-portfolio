---
// src/components/Hero.astro
---
<section id="hero" class="container">
  <div class="hero-content">
    
    <!-- SAMPING KIRI: Nama -->
    <div class="hero-side left-side">
      <h1 class="heading-font name-title">
        <span class="first-name">Christian</span>
        <span class="last-name">Kusumadjaja.</span>
      </h1>
    </div>
    
    <!-- TENGAH: Foto Profil & Bingkai -->
    <div class="hero-center">
      <div class="image-frame portrait-frame">
        <img src="/foto-christian.jpeg" alt="Christian Kusumadjaja" class="profile-img" />
      </div>
    </div>

    <!-- SAMPING KANAN: Tagline -->
    <div class="hero-side right-side">
      <p class="tagline heading-font">The Empathetic<br/>Systems-Thinker.</p>
      <div class="side-divider"></div>
      <p class="sub-tagline">
        Computer Science & Database Technology. <br/> 
        Bridging Data Architecture with Human-Centric Design.
      </p>
    </div>

  </div>
</section>

<style>
  #hero {
    min-height: 85vh; 
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 4rem;
    position: relative; 
  }

  .hero-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    position: relative; 
  }

  .hero-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 32%; 
    z-index: 20;
  }

  .left-side { text-align: right; align-items: flex-end; }
  .right-side { text-align: left; align-items: flex-start; }

  .name-title { 
    font-size: 3.5rem; 
    line-height: 1.1; 
    margin: 0; 
    color: var(--text-color); 
    display: flex; 
    flex-direction: column; 
  }
  .first-name { font-weight: 600; letter-spacing: -0.02em; }
  .last-name { 
    font-style: italic; 
    color: var(--accent-color); 
    padding-right: 1rem; 
  }

  .tagline { font-size: 2.2rem; line-height: 1.2; color: var(--text-color); margin: 0; }
  .side-divider { width: 60px; height: 2px; background-color: var(--accent-color); margin: 1.5rem 0; }
  .sub-tagline {
    font-family: var(--font-body); font-size: 0.95rem; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--text-color); opacity: 0.7; margin: 0; line-height: 1.8;
  }

  /* BINGKAI TEBAL COKELAT & DALAM PUTIH */
  .image-frame {
    background-color: #FFFFFF; 
    border: 12px solid var(--accent-color); 
    padding: 1rem; 
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .portrait-frame {
    width: 300px; 
    aspect-ratio: 3 / 4; 
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media print {
    #hero { height: 100vh; min-height: 100vh; border-bottom: none; margin-bottom: 0; page-break-after: always; }
    .name-title { font-size: 3rem; }
    .tagline { font-size: 2rem; }
    .image-frame { border-width: 6px; padding: 0.75rem; }
    .portrait-frame { width: 280px; }
  }
</style>