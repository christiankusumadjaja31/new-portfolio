---
// src/components/Hero.astro
---
<section id="hero" class="hero container">
  <div class="hero-left">
    <h1>Christian<br/>Kusumadjaja</h1>
  </div>
  
  <div class="hero-center">
    <div class="image-frame">
      <img src="/foto-christian.jpeg" alt="Christian Kusumadjaja" />
    </div>
  </div>
  
  <div class="hero-right">
    <p class="tagline">"<i>Computer Science &<br/>Database Engineering<br/>Enthusiast</i>"</p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    /* Memastikan foto tepat di tengah, dan teks di sisi mengapitnya */
    grid-template-columns: 1fr auto 1fr; 
    align-items: center;
    gap: 3rem;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .hero-left h1 {
    font-size: 2.6rem; 
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-center {
    display: flex;
    justify-content: center;
  }

  /* --- MUSEUM DOUBLE MAT FRAME --- */
  .image-frame {
    width: 260px; /* Ukuran foto yang ramping dan proporsional */
    aspect-ratio: 3/4;
    background-color: var(--text-color); /* Bingkai luar gelap (Espresso) */
    padding: 1rem; /* Ketebalan bingkai luar */
    border-radius: 4px;
    box-shadow: 10px 20px 40px rgba(42, 36, 33, 0.15); /* Bayangan lembut ala lampu galeri */
  }

  .image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Matting dalam (Kertas terang di sekeliling foto) */
    border: 8px solid var(--bg-color); 
    /* Garis demarkasi super tipis yang memisahkan bingkai gelap dan matting terang */
    outline: 1px solid rgba(255, 255, 255, 0.2); 
  }
  /* ------------------------------- */

  .hero-right {
    display: flex;
    justify-content: flex-end;
    text-align: right;
  }

  /* Gaya kutipan elegan untuk tagline */
  .tagline {
    color: var(--accent-color);
    font-size: 1.2rem;
    line-height: 1.5;
    letter-spacing: 0.03em;
    font-family: var(--font-heading);
  }

  /* Keajaiban PDF (Print) */
  @media print {
    .hero {
      padding-top: 4rem;
      padding-bottom: 2rem;
      gap: 2rem;
    }
    .hero-left h1 { font-size: 2.4rem; }
    
    .image-frame {
      width: 230px; /* Diperkecil sedikit lagi khusus untuk muat di kertas A4 */
      box-shadow: none; /* Hilangkan bayangan di PDF agar bersih */
      /* Memaksa printer mencetak warna gelap pada bingkai */
      -webkit-print-color-adjust: exact; 
      print-color-adjust: exact;
    }
  }
</style>